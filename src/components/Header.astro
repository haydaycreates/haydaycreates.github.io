---
import { site } from '../site.config.js';
import { ICONS } from '../lib/format.js';

const { active = '' } = Astro.props;
const links = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/resources/', label: 'Resources' },
  { href: '/blog/', label: 'Blog' },
];
---

<header class="site-head">
  <div class="wrap head-inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">❧</span>
      <span class="brand-text">{site.title}</span>
    </a>
    <button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" data-nav-toggle
      set:html={ICONS.menu}></button>
    <nav class="site-nav" data-nav>
      {links.map((link) => (
        <a
          href={link.href}
          class={active === link.href ? 'is-active' : undefined}
          aria-current={active === link.href ? 'page' : undefined}
        >{link.label}</a>
      ))}
      {site.writeLink && (
        <a class="btn btn-ghost btn-sm nav-write" href={site.writeLink}>
          <Fragment set:html={ICONS.pen} /> Write
        </a>
      )}
    </nav>
  </div>
</header>
